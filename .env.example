# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.

# Your deployed URL (used for SEO, Open Graph and the sitemap).
NEXT_PUBLIC_SITE_URL=https://vinayak-donawad.vercel.app

# Web3Forms access key — free at https://web3forms.com (enter vinayakdon25@gmail.com).
# Leave empty and the contact form opens the visitor's email app instead.
# This key is designed to be public; it only allows sending to your inbox.
NEXT_PUBLIC_WEB3FORMS_KEY=
